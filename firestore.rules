rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The user management app on this project manages every profile, so that
    // branch stays here to keep both apps working on the same database.
    function managesAllProfiles() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Only members of a room may read the room document and its messages.
    function isRoomMember(roomId) {
      return signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/rooms/$(roomId)
        ).data.memberIds;
    }

    match /users/{userId} {

      // Any signed-in user can read the directory.
      allow read: if signedIn();

      // SimpleChat writes its own profile, and that profile holds only a name.
      allow create, update: if (signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys()
          .hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100)
        || managesAllProfiles();

      allow delete: if managesAllProfiles();
    }

    match /rooms/{roomId} {

      allow read: if signedIn()
        && request.auth.uid
          in resource.data.memberIds;

      // Rooms and messages are written by the backend through the Admin SDK.
      allow write: if false;

      match /messages/{messageId} {

        allow read: if isRoomMember(roomId);

        allow write: if false;
      }
    }
  }
}
