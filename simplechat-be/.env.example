PORT=3001
# Several origins are allowed by listing them with a comma.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
BACKEND_PROVIDER=appwrite

FIREBASE_PROJECT_ID=your-firebase-project-id
# Absolute path to the service account JSON file.
# Keep the file outside the repository, for example inside your home folder.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/your-name/.config/simplechat/service-account.json

# Appwrite server (isi jika BACKEND_PROVIDER=appwrite)
APPWRITE_ENDPOINT=http://localhost/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_COLLECTION_USERS=users
APPWRITE_COLLECTION_CHATS=chats
APPWRITE_COLLECTION_MESSAGES=messages
