NEXT_PUBLIC_BACKEND_PROVIDER=firebase

# Firebase web configuration. These values are safe to expose in the browser;
# data access is still guarded by Firestore Security Rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Address of the Express backend.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Appwrite (isi jika pakai provider appwrite)
NEXT_PUBLIC_APPWRITE_ENDPOINT=http://localhost/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_COLLECTION_USERS=users
NEXT_PUBLIC_APPWRITE_COLLECTION_ROOMS=rooms
NEXT_PUBLIC_APPWRITE_COLLECTION_MESSAGES=messages
